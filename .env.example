# Copy to .env.local and fill in. Never commit real values.
# Local setup: every service runs on this machine. Cloud values are placeholders for later.

APP_URL=http://localhost:3000

# --- Database (PostgreSQL with btree_gist) ---
# Local:  postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Cloud:  the hosted Postgres connection string (must allow CREATE EXTENSION btree_gist)
DATABASE_URL=
TEST_DATABASE_URL=

# --- Auth (Better Auth, email + password) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Payments ---
# fake = local test provider; stripe = real provider (not implemented yet)
PAYMENTS_PROVIDER=fake
PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
PAYMENTS_WEBHOOK_SECRET=
# Fake provider only
FAKE_PAYMENTS_STATE_FILE=./.local/fake-payments.json
FAKE_PAYMENTS_DUPLICATE_WEBHOOKS=false
# Real provider (later)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- File storage ---
# local = private ./uploads folder; s3 = S3-compatible bucket (not implemented yet)
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
# S3-compatible storage (later)
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scheduled jobs ---
# Locally run `pnpm jobs:release-holds`; in the cloud a scheduler calls it, authenticated with this secret
CRON_SECRET=
