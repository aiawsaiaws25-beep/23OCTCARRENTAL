# DriveEasy environment variables. Copy to .env.local for local development.
# Never commit real values. Everything here is server-only except NEXT_PUBLIC_* (safe to expose).
#
# Environments
#   Local:       .env.local (this file as a template). Local Postgres, fake payments, local uploads.
#   Preview:     Vercel "Preview" env. Neon branch per preview (Vercel Marketplace integration sets
#                DATABASE_URL / DATABASE_URL_UNPOOLED automatically), Stripe TEST keys, a Blob store.
#   Production:  Vercel "Production" env. Neon main branch, Stripe keys, production Blob store,
#                different BETTER_AUTH_SECRET / CRON_SECRET / VOUCHER_SECRET from preview.
#   Migrations run at build time with `pnpm db:deploy` (vercel.json buildCommand) over the
#   UNPOOLED URL; the running app uses the pooled DATABASE_URL.

APP_URL=http://localhost:3000
# debug | info | warn | error | silent (JSON logs on stdout/stderr)
LOG_LEVEL=info

# --- Database (PostgreSQL 16+ with the btree_gist extension) ---
# Local:  postgres://driveeasy:<password>@localhost:5432/driveeasy_dev
# Neon:   pooled URL (host contains "-pooler"), e.g. postgres://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
DATABASE_URL=
# Neon direct (non-pooled) URL, used only for migrations. Leave empty locally.
DATABASE_URL_UNPOOLED=
# Local tests only (qa): postgres://driveeasy:<password>@localhost:5432/driveeasy_test
TEST_DATABASE_URL=
# Max connections per server instance (keep small on serverless; Neon's pooler multiplexes).
DB_POOL_MAX=10

# --- Auth (Better Auth, email + password) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
# Public base URL of the deployment (Vercel: https://<project>.vercel.app or your domain)
BETTER_AUTH_URL=http://localhost:3000

# --- Payments ---
# fake = local test provider (default); stripe = Stripe TEST mode adapter
PAYMENTS_PROVIDER=fake
# Fake provider only
PAYMENTS_WEBHOOK_URL=http://localhost:3000/api/webhooks/payments
PAYMENTS_WEBHOOK_SECRET=
FAKE_PAYMENTS_STATE_FILE=./.local/fake-payments.json
FAKE_PAYMENTS_DUPLICATE_WEBHOOKS=false
# Stripe (PAYMENTS_PROVIDER=stripe). Test keys start with sk_test_ / pk_test_.
# Webhook endpoint to register in Stripe: https://<host>/api/webhooks/payments with events
#   payment_intent.succeeded, payment_intent.payment_failed, payment_intent.canceled,
#   payment_intent.amount_capturable_updated, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- File storage (driving licences, damage photos: always private) ---
# local = private ./uploads folder; vercel-blob = Vercel Blob store with private access
STORAGE_PROVIDER=local
UPLOADS_DIR=./uploads
# Vercel Blob (STORAGE_PROVIDER=vercel-blob); set automatically when a Blob store is linked
BLOB_READ_WRITE_TOKEN=

# --- Scheduled jobs ---
# Vercel Cron calls GET /api/cron/release-holds with "Authorization: Bearer $CRON_SECRET"
# (vercel.json). Locally: `pnpm jobs:release-holds`. At least 16 characters.
CRON_SECRET=

# --- Vouchers ---
# HMAC key for voucher QR codes (optional; defaults to BETTER_AUTH_SECRET)
VOUCHER_SECRET=
